# ==============================================================================
# OpsMind AI Platform — Essential Environment Variables Template
# ==============================================================================

# Core App Settings
ENVIRONMENT="development"
DEBUG=true

# Supabase Project Configuration & Auth Keys
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Frontend Supabase Keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase PostgreSQL Connection String (AsyncPG)
# Example: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Google Gemini AI Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Inbound Email Webhook Secret
WEBHOOK_SECRET="opsmind_webhook_secret_key"
